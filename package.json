{
  "name": "origami-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kod ile üretilen origami animasyonları ve MP4 video çıktısı",
  "scripts": {
    "dev": "node server/index.js",
    "dev:lan": "node server/index.js --lan",
    "build": "vite build",
    "start": "node server/index.js --prod",
    "seed": "node scripts/seed-library.js",
    "seed:force": "node scripts/seed-library.js --force",
    "notes": "node scripts/notes.js",
    "proje-sil": "node scripts/proje-sil.mjs",
    "simulasyon-aktar": "node scripts/simulasyon-aktar.mjs",
    "seed:hikaye": "node scripts/seed-hikaye.mjs",
    "fonts": "node scripts/fetch-fonts.js",
    "seed:design": "node scripts/seed-design.js",
    "seed:bilesen": "node scripts/seed-components.mjs",
    "seed:sekil": "node scripts/seed-sekiller.mjs",
    "seed:sosyal": "node scripts/seed-sosyal.mjs",
    "vektor": "node scripts/gorselden-vektor.mjs",
    "ritim": "node scripts/gen-ritim.mjs",
    "seed:karakter": "node scripts/seed-characters.mjs",
    "etiketle:bilesen": "node scripts/etiketle-bilesen.mjs",
    "bilesen": "node scripts/bilesen-ara.mjs",
    "karakter": "node scripts/karakter-ara.mjs",
    "gen-audio": "node scripts/gen-audio.js && node scripts/gen-sfx.js",
    "katalog": "node scripts/katalog.js",
    "uret": "node scripts/uret.mjs",
    "dogrula": "node scripts/dogrula.mjs",
    "render": "node scripts/render.mjs",
    "zarf": "node scripts/analyze-audio.mjs",
    "seslendir": "node scripts/seslendir.mjs",
    "sesler": "node scripts/sesler.mjs",
    "muzik": "node scripts/muzik.mjs",
    "ai-notlar": "node scripts/ai-notlar.mjs",
    "ara": "node scripts/kutuphane-ara.mjs",
    "onay": "node scripts/onay.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tweenjs/tween.js": "^25.0.0",
    "cannon-es": "^0.20.0",
    "chart.js": "^4.5.1",
    "d3": "^7.9.0",
    "express": "^5.2.1",
    "matter-js": "^0.20.0",
    "mp4-muxer": "^5.2.2",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.160.0",
    "vue": "^3.5.43",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.3.1",
    "vue3-smooth-dnd": "^1.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "vite": "^8.3.1"
  }
}
